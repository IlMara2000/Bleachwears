NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SUPABASE_CATALOG_ENABLED=false
NEXT_PUBLIC_SITE_URL=https://bleachwears.vercel.app

# Checkout: senza queste chiavi gli ordini vengono registrati senza addebito
# e restano solo in memoria sul server. Con STRIPE_SECRET_KEY il checkout
# reindirizza alla pagina di pagamento Stripe. Con SUPABASE_SERVICE_ROLE_KEY
# gli ordini vengono salvati su public.orders (migrazione in supabase/migrations).
STRIPE_SECRET_KEY=
# Segreto del webhook Stripe (dashboard → Developers → Webhooks → endpoint
# /api/stripe/webhook, eventi checkout.session.*). Senza, il webhook rifiuta.
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Stencil Lab (/bwslab) — provider gratuito (consigliato).
# Cloudflare Workers AI, piano Free: 10.000 neurons al giorno senza carta.
# FLUX.2 Klein 9B costa ~1.545 neurons per immagine: circa 6 al giorno.
# Account ID e token (permesso Workers AI) stanno nella dashboard Cloudflare;
# con queste due variabili il provider gratuito ha la precedenza su Gemini.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-2-klein-9b
# cloudflare | gemini: forza un provider quando entrambi sono configurati.
STENCIL_PROVIDER=

# Stencil Lab (/bwslab) — alternativa a pagamento: Gemini Nano Banana 2.1.
# Serve GEMINI_API_KEY per generare.
# Modello image-to-image Gemini Nano Banana 2.1, nessun piano gratuito:
# circa 0,034 $ per immagine a 1K (2K ~0,050, 4K ~0,113).
# Senza chiave la pagina resta visibile ma non genera e lo dice.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-nano-banana-2.1
# 1K | 2K | 4K
GEMINI_IMAGE_SIZE=1K
