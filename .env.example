NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SUPABASE_CATALOG_ENABLED=false
NEXT_PUBLIC_SITE_URL=https://bleachwears.vercel.app

# Checkout: senza queste chiavi gli ordini vengono registrati senza addebito
# e restano solo in memoria sul server. Con STRIPE_SECRET_KEY il checkout
# reindirizza alla pagina di pagamento Stripe. Con SUPABASE_SERVICE_ROLE_KEY
# gli ordini vengono salvati su public.orders (migrazione in supabase/migrations).
STRIPE_SECRET_KEY=
# Segreto del webhook Stripe (dashboard → Developers → Webhooks → endpoint
# /api/stripe/webhook, eventi checkout.session.*). Senza, il webhook rifiuta.
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
