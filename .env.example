NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SUPABASE_CATALOG_ENABLED=false
NEXT_PUBLIC_SITE_URL=https://bleachwears.vercel.app

# Checkout: senza queste chiavi gli ordini vengono registrati senza addebito
# e restano solo in memoria sul server. Con STRIPE_SECRET_KEY il checkout
# reindirizza alla pagina di pagamento Stripe. Con SUPABASE_SERVICE_ROLE_KEY
# gli ordini vengono salvati su public.orders (migrazione in supabase/migrations).
STRIPE_SECRET_KEY=
# Segreto del webhook Stripe (dashboard → Developers → Webhooks → endpoint
# /api/stripe/webhook, eventi checkout.session.*). Senza, il webhook rifiuta.
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Stencil Lab (/bwslab) — provider locale (ComfyUI su questa macchina).
# Nessuna chiave, nessun costo, nessun upload: le immagini non escono dal computer.
# Funziona solo dove il server raggiunge 127.0.0.1 (sviluppo locale o self-hosting),
# non su un deploy Vercel. Richiede ComfyUI attivo con Qwen-Image-Edit 2509 GGUF.
# STENCIL_PROVIDER=local
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_MEGAPIXELS=0.5
# COMFYUI_STEPS=4
# COMFYUI_CFG=1
# COMFYUI_UNET=Qwen-Image-Edit-2509-Q2_K.gguf
# COMFYUI_CLIP=Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf
# COMFYUI_VAE=qwen_image_vae.safetensors
# COMFYUI_LORA=Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors

# Stencil Lab (/bwslab) — tetto di spesa.
# Generazioni al giorno accettate dal server. Il controllo avviene PRIMA di
# chiamare il provider, quindi una richiesta rifiutata (429) non costa nulla.
# Conta i tentativi, non i successi: una generazione fallita può essere
# addebitata lo stesso. 0 = nessun tetto (default quando il provider è locale).
# Default per i provider a pagamento: 6, cioè l'intero piano gratuito Cloudflare.
STENCIL_DAILY_CAP=6
# Per un tetto globale e non per-istanza serve un contatore condiviso: Vercel KV
# o Upstash Redis (stesso dialetto REST). Senza queste due variabili il conteggio
# vive nella memoria della singola istanza: su serverless è una stima, non una
# garanzia. Con Redis il contatore è unico e si azzera da solo a mezzanotte UTC.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Stencil Lab (/bwslab) — provider gratuito (consigliato).
# Cloudflare Workers AI, piano Free: 10.000 neurons al giorno senza carta.
# FLUX.2 Klein 9B costa ~1.545 neurons per immagine: circa 6 al giorno.
# Account ID e token (permesso Workers AI) stanno nella dashboard Cloudflare;
# con queste due variabili il provider gratuito ha la precedenza su Gemini.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-2-klein-9b
# cloudflare | gemini: forza un provider quando entrambi sono configurati.
STENCIL_PROVIDER=

# Stencil Lab (/bwslab) — alternativa a pagamento: Gemini Nano Banana 2.1.
# Serve GEMINI_API_KEY per generare.
# Modello image-to-image Gemini Nano Banana 2.1, nessun piano gratuito:
# circa 0,034 $ per immagine a 1K (2K ~0,050, 4K ~0,113).
# Senza chiave la pagina resta visibile ma non genera e lo dice.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-nano-banana-2.1
# 1K | 2K | 4K
GEMINI_IMAGE_SIZE=1K
