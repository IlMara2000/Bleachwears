NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SUPABASE_CATALOG_ENABLED=false
NEXT_PUBLIC_SITE_URL=https://bleachwears.vercel.app

# Checkout: senza queste chiavi gli ordini vengono registrati senza addebito
# e restano solo in memoria sul server. Con STRIPE_SECRET_KEY il checkout
# reindirizza alla pagina di pagamento Stripe. Con SUPABASE_SERVICE_ROLE_KEY
# gli ordini vengono salvati su public.orders (migrazione in supabase/migrations).
STRIPE_SECRET_KEY=
# Segreto del webhook Stripe (dashboard → Developers → Webhooks → endpoint
# /api/stripe/webhook, eventi checkout.session.*). Senza, il webhook rifiuta.
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Stencil Lab (/bwslab) — provider locale (ComfyUI su questa macchina).
# Nessuna chiave, nessun costo, nessun upload: le immagini non escono dal computer.
# Funziona solo dove il server raggiunge 127.0.0.1 (sviluppo locale o self-hosting),
# non su un deploy Vercel. Richiede ComfyUI attivo con Qwen-Image-Edit 2509 GGUF.
# STENCIL_PROVIDER=local
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_MEGAPIXELS=0.5
# COMFYUI_STEPS=4
# COMFYUI_CFG=1
# COMFYUI_UNET=Qwen-Image-Edit-2509-Q2_K.gguf
# COMFYUI_CLIP=Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf
# COMFYUI_VAE=qwen_image_vae.safetensors
# COMFYUI_LORA=Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors

# Stencil Lab (/bwslab) — tetto di spesa.
# Generazioni al giorno accettate dal server. Il controllo avviene PRIMA di
# chiamare il provider, quindi una richiesta rifiutata (429) non costa nulla.
# Il gettone si prende prima di chiamare il provider, ma se la generazione
# fallisce torna indietro: un errore non consuma il tetto e non costa.
# 0 = nessun tetto (default quando il provider è locale).
# Default per i provider a pagamento: una generazione al giorno.
STENCIL_DAILY_CAP=1
# Per un tetto globale e non per-istanza serve un contatore condiviso: Vercel KV
# o Upstash Redis (stesso dialetto REST). Senza queste due variabili il conteggio
# vive nella memoria della singola istanza: su serverless è una stima, non una
# garanzia. Con Redis il contatore è unico e si azzera da solo a mezzanotte UTC.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Stencil Lab — due pagine, due configurazioni.
# /bwslab (stencil) e /bwslab/nfsw (pressa del prompt) risolvono provider,
# chiave e modello ognuna per conto suo: una quota esaurita su una pagina non
# ferma l'altra. Senza queste variabili ogni pagina ricade sulla configurazione
# condivisa qui sotto, quindi un deploy esistente continua a funzionare.
# provider: cloudflare | gemini | qwen | local (STENCIL_PROVIDER vale per entrambe).
STENCIL_LAB_PROVIDER=
STENCIL_PRESS_PROVIDER=qwen
# Chiave della pagina: vale per il provider che quella pagina usa.
# Equivale a GEMINI_API_KEY per Gemini e a DASHSCOPE_API_KEY per Qwen.
STENCIL_LAB_API_KEY=
STENCIL_PRESS_API_KEY=
# Modello: opzionale, sovrascrive il default del provider.
STENCIL_LAB_MODEL=
STENCIL_PRESS_MODEL=
# Tetto giornaliero per pagina: vince su STENCIL_DAILY_CAP.
STENCIL_LAB_DAILY_CAP=
STENCIL_PRESS_DAILY_CAP=

# Qwen (Alibaba Model Studio) — la pressa del prompt, con quota gratuita.
# La quota gratuita è per account e per modello (circa 1M token, 90 giorni,
# regione Singapore): una seconda chiave dello stesso account non la raddoppia,
# serve un altro account o un altro provider per una quota davvero separata.
# DASHSCOPE_BASE_URL serve solo se la chiave è di un'altra regione.
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
# QWEN_IMAGE_MODEL=qwen-image-2.0-pro

# Stencil Lab (/bwslab) — provider gratuito (consigliato).
# Cloudflare Workers AI, piano Free: 10.000 neurons al giorno senza carta.
# FLUX.2 Klein 9B costa ~1.545 neurons per immagine: circa 6 al giorno.
# Account ID e token (permesso Workers AI) stanno nella dashboard Cloudflare;
# con queste due variabili il provider gratuito ha la precedenza su Gemini.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-2-klein-9b
# cloudflare | gemini: forza un provider quando entrambi sono configurati.
STENCIL_PROVIDER=

# Stencil Lab (/bwslab) — alternativa a pagamento: Gemini Nano Banana 2.1.
# Serve GEMINI_API_KEY per generare.
# Modello image-to-image Gemini Nano Banana 2.1, nessun piano gratuito:
# circa 0,034 $ per immagine a 1K (2K ~0,050, 4K ~0,113).
# Senza chiave la pagina resta visibile ma non genera e lo dice.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-nano-banana-2.1
# 1K | 2K | 4K
GEMINI_IMAGE_SIZE=1K

# Conferma d'ordine via email — provider transazionale con API HTTP (default Resend).
# La conferma parte dal webhook di Stripe, dopo che l'ordine risulta pagato.
# Senza queste variabili il negozio incassa lo stesso: l'email viene solo saltata
# e nel log compare {"event":"order.email","ok":false,"reason":"not-configured"}.
# RESEND_API_KEY: chiave del provider, solo server (mai NEXT_PUBLIC_).
RESEND_API_KEY=
# ORDER_FROM_EMAIL: mittente su un dominio verificato presso il provider,
# nella forma "Bleachwears <ordini@tuodominio.it>". Senza dominio verificato
# il provider rifiuta l'invio (403).
ORDER_FROM_EMAIL=
# ORDER_REPLY_TO: opzionale, dove arrivano le risposte dei clienti.
ORDER_REPLY_TO=
