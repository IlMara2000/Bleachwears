<section class="catalog wrap">
  <div class="section-head">
    <h2>{{ section.settings.heading }}</h2>
    <p>Collezioni</p>
  </div>

  <div class="grid">
    {%- for collection in collections -%}
      {%- if collection.all_products_count > 0 -%}
        <a class="collection-card" href="{{ collection.url }}">
          {%- if collection.featured_image != blank -%}
            {{ collection.featured_image
              | image_url: width: 600
              | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 860px) 30vw, 90vw', alt: collection.title | escape }}
          {%- else -%}
            <div class="thumb">{% render 'garment-placeholder', shape: 'hoodie', color: '#d8d5ce' %}</div>
          {%- endif -%}
          <span>{{ collection.title }} <em>{{ collection.all_products_count }}</em></span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Lista collezioni",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Collezioni" }
  ]
}
{% endschema %}
