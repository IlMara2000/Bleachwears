<section class="catalog wrap" id="catalog">
  <div class="section-head">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>

  <div class="grid">
    {%- assign col = collections[section.settings.collection] -%}
    {%- for product in col.products limit: section.settings.products_to_show -%}
      {% render 'product-card', card_product: product %}
    {%- else -%}
      {%- for i in (1..4) -%}
        <article class="card">
          <div class="thumb">{% render 'garment-placeholder', shape: 'tee', color: '#d8d5ce' %}</div>
          <div class="card-body">
            <div class="card-row"><strong>Prodotto di esempio</strong><span>—</span></div>
            <button class="add" type="button" disabled>Aggiungi</button>
          </div>
        </article>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collezione in vetrina",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Catalogo" },
    { "type": "text", "id": "subheading", "label": "Sottotitolo", "default": "Spedizione gratuita sopra €120" },
    { "type": "collection", "id": "collection", "label": "Collezione" },
    { "type": "range", "id": "products_to_show", "label": "Prodotti da mostrare", "min": 2, "max": 12, "step": 1, "default": 5 }
  ],
  "presets": [{ "name": "Collezione in vetrina" }]
}
{% endschema %}
