<section class="wrap">
  <div class="empty-state">
    <h1>Pagina non trovata</h1>
    <p>Il capo che cercavi potrebbe essere andato sold out o la pagina è stata spostata. Dal catalogo trovi il drop completo.</p>
    <a class="btn-shop" href="{{ routes.all_products_collection_url }}">Torna al catalogo</a>
  </div>

  {%- assign col = collections[section.settings.collection] -%}
  {%- if col.products.size > 0 -%}
    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
      <p>Selezione dal catalogo</p>
    </div>
    <div class="grid">
      {%- for product in col.products limit: 4 -%}
        {% render 'product-card', card_product: product %}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Pagina 404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo suggerimenti", "default": "Potrebbe interessarti" },
    { "type": "collection", "id": "collection", "label": "Collezione suggerita" }
  ]
}
{% endschema %}
